# Copy to .env for local dev. Real values live only in Railway and GitHub Actions secrets.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5-5
DAILY_BUDGET_USD=5
RATE_LIMIT_PER_MIN=10
PORT=3001
# Proxy hops in front of the app, so the rate limit keys on the visitor. Railway: 2 (read xffCount from the
# one-time client_ip_shape log on a new host). Locally there is no proxy; the default 1 is harmless.
# TRUST_PROXY=2
