{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/block-destructive.sh" }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/block-secret-lockfile-edit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/lint-format-changed.sh" }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "bash scripts/hooks/full-check.sh" }] }]
  }
}
